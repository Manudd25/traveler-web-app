# Public frontend config — never commit real secrets in source files
# Copy to `.env` and fill in values. `.env` is gitignored.

# Cloudflare Worker URL for Atlas (no trailing slash)
# Locally you can leave this empty and run `npm run ai` (Vite proxies /api/ai → :8787)
AI_API_URL=https://traveler-guide.didariomanuela.workers.dev

# Mapbox public token (pk.*) — create at https://account.mapbox.com/access-tokens/
# Restrict by URL in the Mapbox dashboard. Never commit sk.* or paste tokens into source.
MAPBOX_TOKEN=
